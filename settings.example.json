{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allowDangerouslySkipPermissions": true,
    "disableAutoMode": "disable",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(rm -rf /Users)",
      "Bash(rm -rf ~)",
      "Bash(mkfs *)",
      "Bash(dd if=* of=/dev/*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "sandbox": {
    "filesystem": {
      "disabled": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/YOUR_USERNAME/.claude/hooks/danger-guard.py"
          }
        ]
      }
    ]
  }
}
